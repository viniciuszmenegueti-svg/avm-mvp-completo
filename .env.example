APP_NAME=AVM Imoveis API
APP_VERSION=0.3.1
APP_DESCRIPTION=Plataforma local para automacao de avaliacoes e precificacao de imoveis.
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
ALLOW_SYNTHETIC_PRICING=false
MODEL_EXECUTION_MODE=DEMONSTRATION

# CONTRACTUAL permanece bloqueado no código até a conclusão e o registro
# dos gates externos formais; não tente liberá-lo por variável local.

ADMIN_CREDENTIALS_JSON={"model-trainer":"replace_with_random_trainer_key_32_chars","model-reviewer":"replace_with_random_reviewer_key_32_chars"}

ADMIN_API_KEY=
ADMIN_ACTOR=
CLIENT_CREDENTIALS_JSON={"caixa-integration":"replace_with_at_least_24_random_characters"}

POSTGRES_DB=avm
POSTGRES_USER=avm_app
POSTGRES_PASSWORD=replace_with_a_strong_random_database_password
POSTGRES_PORT=5433
POSTGRES_CONTAINER_NAME=avm-postgres

API_PORT=8000
API_CONTAINER_NAME=avm-api

DATABASE_URL=postgresql+psycopg://avm_app:replace_with_a_strong_random_database_password@localhost:5433/avm
