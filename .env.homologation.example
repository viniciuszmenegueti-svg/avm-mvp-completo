APP_NAME=AVM Imoveis API - Homologacao
APP_VERSION=0.3.1
APP_DESCRIPTION=Ambiente isolado para testes de homologacao da plataforma AVM.
APP_ENV=homologation
APP_DEBUG=false
LOG_LEVEL=INFO
ALLOW_SYNTHETIC_PRICING=false

ADMIN_CREDENTIALS_JSON={"admin-homologation":"replace_with_at_least_24_random_characters"}
ADMIN_API_KEY=
ADMIN_ACTOR=
CLIENT_CREDENTIALS_JSON={"client-homologation":"replace_with_at_least_24_random_characters"}

POSTGRES_DB=avm
POSTGRES_USER=avm_app
POSTGRES_PASSWORD=replace_with_a_random_database_password
POSTGRES_PORT=5434
POSTGRES_CONTAINER_NAME=avm-homologation-postgres

API_PORT=8001
API_CONTAINER_NAME=avm-homologation-api

DATABASE_URL=postgresql+psycopg://avm_app:replace_with_a_random_database_password@localhost:5434/avm
